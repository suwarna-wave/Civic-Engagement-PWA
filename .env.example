# The current demo PWA requires no environment variables.
# Keep this file as the checklist for the deferred production integration.

# Supabase — future production phase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key

# Sparrow SMS — future production phase; server-only
SPARROW_SMS_TOKEN=your-sparrow-token
SPARROW_SMS_FROM=your-approved-sender-id
SPARROW_SMS_API_URL=https://api.sparrowsms.com/v2/sms/

# OTP — future production phase
OTP_EXPIRY_SECONDS=180
OTP_MAX_SENDS_PER_WINDOW=3
OTP_RATE_WINDOW_SECONDS=600
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_HMAC_SECRET=replace-with-a-long-random-secret

# App
NEXT_PUBLIC_APP_NAME=Swatantra Aawaj — Koshi
